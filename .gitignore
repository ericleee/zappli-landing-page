# ─────────────────────────────────────────────
# Zappli Landing Page — .gitignore
# ─────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets — NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12

# Vercel
.vercel

# Testing / coverage
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Private planning notes — kept local, never published
SETUP_AND_COSTS.md
ASSETS_NEEDED.md

# Raw source assets — heavy originals; optimized versions live in public/
assets/

# Local waitlist mock data (Stage A, pre-publish)
waitlist.local.json

# Local tools (portable ffmpeg, etc.) — large binaries, never committed
.tools/
