# ─────────────────────────────────────────────
# Zappli Landing Page — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real keys.
# ─────────────────────────────────────────────

# Supabase — used client-side. The anon key is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — transactional / confirmation email. SERVER + SECRET ONLY.
# Do NOT prefix with NEXT_PUBLIC_. Store this in the Vercel dashboard and
# in Supabase secrets — never in this repository.
RESEND_API_KEY=
